{
  "name": "esn/esn_test",
  "description": "This is a simple test for our esners.",
  "authors": [
    {
      "name": "Gorka Guerrero",
      "email": "gorka.guerrero@esn.org"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.4",
    "lipis/flag-icons": "^7.6",
    "twig/twig": "^3.0",
    "phpoffice/phpspreadsheet": "^1.13",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "drupal/coder": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "EsnTest\\": "src/"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
